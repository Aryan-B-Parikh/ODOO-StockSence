# Root env file consumed by docker-compose.yml.
# Copy to `.env` and adjust for local use: `cp .env.example .env` (or copy on Windows).

# --- PostgreSQL (docker-compose db service) ---
POSTGRES_USER=stocksense
POSTGRES_PASSWORD=stocksense
POSTGRES_DB=stocksense
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=4000
# Must be a long random string outside local dev.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=12h
# Origin allowed by CORS (vite dev server / compose frontend).
CORS_ORIGIN=http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=5173
# When true the frontend serves /auth/* (and later phases) from MSW mocks.
# docker-compose sets this to false to run against the real backend.
VITE_USE_MSW=false

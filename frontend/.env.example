# Copy to frontend/.env.development (or .env.local) to override.
#
# Serve the UI from MSW mock fixtures matching docs/05_API_CONTRACTS.md.
# Set to false to hit the real backend through the Vite /api proxy.
VITE_USE_MSW=true

# Optional: override the API base path (defaults to /api/v1 via the Vite proxy).
# VITE_API_BASE_URL=/api/v1

# Optional: where the Vite dev proxy forwards /api requests.
# VITE_PROXY_TARGET=http://localhost:4000
